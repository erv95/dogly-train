{
  "expo": {
    "name": "Dogly Train",
    "slug": "dogly-train",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5A623"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.dogly.train",
      "versionCode": 2,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#F5A623",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "dogly-train",
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Dogly Train uses your location to show nearby dog trainers."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F5A623"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Dogly Train needs camera access to send photos in chat.",
          "photosPermission": "Dogly Train needs photo access to share images in chat.",
          "microphonePermission": "Dogly Train needs microphone access to send voice messages."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Dogly Train needs microphone access to record voice messages."
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "421d0374-805a-431f-99f6-f56b2a02baf3"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/421d0374-805a-431f-99f6-f56b2a02baf3",
      "fallbackToCacheTimeout": 0
    }
  }
}
